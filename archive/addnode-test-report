            "banscore" : 0
        },
        {
            "addr" : "192.168.0.202:8333",
            "services" : "00000001",
            "lastsend" : 1359318562,
            "lastrecv" : 1359318559,
            "conntime" : 1359318522,
            "version" : 70001,
